<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Exe = консольная программа с точкой входа (как jar с Main-Class) -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Частые using подключаются автоматически (System, System.IO, System.Linq...) -->
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Компилятор предупреждает о возможном null. В Java такой проверки нет -->
        <Nullable>enable</Nullable>
        <!-- Только 64 бита: нативная библиотека iec61850.dll собрана под x64 -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <!-- SCL-файлы из Samples копируются рядом с программой при сборке -->
        <None Update="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Нативная часть libIEC61850 (написана на C). Обёртка .NET вызывает её функции -->
        <None Update="iec61850.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Обёртка libIEC61850 для .NET подключается из исходников, как модуль в Maven multi-module -->
        <ProjectReference Include="..\..\libiec61850\dotnet\IEC61850forCSharp\IEC61850.NET.csproj" />
    </ItemGroup>

</Project>
